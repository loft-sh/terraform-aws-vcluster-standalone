#!/bin/bash
set -euo pipefail

ensure_aws_cli() {
  if command -v aws >/dev/null 2>&1; then
    return 0
  fi

  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y awscli
}

cat <<EOF >/root/vcluster.yaml
exportKubeConfig:
  server: https://${load_balancer_dns}:443
controlPlane:
  endpoint: ${load_balancer_dns}:443
  proxy:
    extraSANs:
    - ${load_balancer_dns}
  distro:
    k8s:
      version: ${kubernetes_version}
  backingStore:
    etcd:
      embedded:
        enabled: true
  advanced:
    konnectivity:
      agent:
        enabled: false
      server:
        enabled: false
networking:
  podCIDR: 10.64.0.0/16
  serviceCIDR: 10.128.0.0/16
EOF

curl -sfL "https://github.com/loft-sh/vcluster/releases/download/${vcluster_version}/install-standalone.sh" -o /root/install-standalone.sh
chmod +x /root/install-standalone.sh

sh /root/install-standalone.sh \
  --vcluster-name "${vcluster_name}" \
  --join-token "${cluster_join_token}" \
  --config /root/vcluster.yaml

for attempt in $(seq 1 120); do
  if [ -s /var/lib/vcluster/kubeconfig.yaml ]; then
    break
  fi

  echo "Waiting for kubeconfig to be written (attempt $${attempt}/120)."
  sleep 5
done

if [ ! -s /var/lib/vcluster/kubeconfig.yaml ]; then
  echo "kubeconfig was not created at /var/lib/vcluster/kubeconfig.yaml" >&2
  exit 1
fi

ensure_aws_cli

aws ssm put-parameter \
  --region "${aws_region}" \
  --name "${kubeconfig_parameter_name}" \
  --type "SecureString" \
  --tier "Advanced" \
  --overwrite \
  --value "$(cat /var/lib/vcluster/kubeconfig.yaml)"
