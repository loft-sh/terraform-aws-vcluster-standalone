#!/bin/bash
set -euo pipefail

JOIN_URL="https://${load_balancer_dns}/node/join?token=${cluster_join_token}&type=worker"

for attempt in $(seq 1 300); do
  if curl -sfLk "$${JOIN_URL}" -o /root/join.sh; then
    chmod +x /root/join.sh
    sh /root/join.sh
    exit 0
  fi

  echo "Worker join endpoint is not ready yet (attempt $${attempt}/60). Retrying in 15 seconds."
  sleep 5
done

echo "Unable to fetch the worker join script from $${JOIN_URL}" >&2
exit 1
